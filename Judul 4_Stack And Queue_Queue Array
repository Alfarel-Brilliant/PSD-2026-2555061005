SUMBER KODE
================================================================

# Program: Simulasi Antrian KRS Mahasiswa - Queue Array
# Bahasa  : Python

MAX_SIZE = 5  # Kapasitas maksimal antrian loket

class QueueAntrian:
    def __init__(self):
        self.data = [None] * MAX_SIZE  # Array untuk menyimpan antrian
        self.front = -1               # Indeks depan antrian
        self.rear = -1                # Indeks belakang antrian
        self.jumlah = 0               # Jumlah mahasiswa dalam antrian

    def is_empty(self):
        return self.jumlah == 0

    def is_full(self):
        return self.jumlah == MAX_SIZE

    def enqueue(self, nama_mahasiswa):
        if self.is_full():
            print(f"[PENUH] Antrian sudah penuh! {nama_mahasiswa} tidak bisa masuk.")
            return False
        if self.is_empty():
            self.front = 0
        self.rear = (self.rear + 1) % MAX_SIZE
        self.data[self.rear] = nama_mahasiswa
        self.jumlah += 1
        print(f"[MASUK] {nama_mahasiswa} berhasil masuk ke antrian.")
        return True

    def dequeue(self):
        if self.is_empty():
            print("[KOSONG] Tidak ada mahasiswa dalam antrian.")
            return None
        mahasiswa_dipanggil = self.data[self.front]
        self.data[self.front] = None
        self.front = (self.front + 1) % MAX_SIZE
        self.jumlah -= 1
        if self.jumlah == 0:
            self.front = -1
            self.rear = -1
        print(f"[DIPANGGIL] {mahasiswa_dipanggil} sedang dilayani di loket.")
        return mahasiswa_dipanggil

    def peek(self):
        if self.is_empty():
            print("[INFO] Antrian kosong.")
            return None
        return self.data[self.front]

    def tampilkan_antrian(self):
        print("\n--- STATUS ANTRIAN LOKET KRS ---")
        if self.is_empty():
            print("Antrian kosong.")
        else:
            print(f"Jumlah antrian: {self.jumlah}/{MAX_SIZE}")
            print("Urutan antrian (depan -> belakang):")
            idx = self.front
            for i in range(self.jumlah):
                posisi = (idx + i) % MAX_SIZE
                print(f"  [{i+1}] {self.data[posisi]}")
        print("--------------------------------\n")


def main():
    antrian = QueueAntrian()
    print("=== SISTEM ANTRIAN KRS UNIVERSITAS ===\n")

    # Simulasi mahasiswa datang dan masuk antrian
    daftar_masuk = [
        "Andi - NIM 2021001",
        "Budi - NIM 2021002",
        "Citra - NIM 2021003",
        "Dewi - NIM 2021004",
        "Eko - NIM 2021005",
        "Fajar - NIM 2021006",  # Antrian sudah penuh
    ]

    print(">> Mahasiswa mendaftar ke antrian loket:")
    for mhs in daftar_masuk:
        antrian.enqueue(mhs)

    antrian.tampilkan_antrian()

    # Simulasi mahasiswa dipanggil loket
    print(">> Loket mulai memanggil mahasiswa:\n")
    antrian.dequeue()
    antrian.dequeue()
    antrian.tampilkan_antrian()

    # Mahasiswa baru bisa masuk karena ada slot kosong
    print(">> Mahasiswa baru masuk antrian:")
    antrian.enqueue("Fajar - NIM 2021006")
    antrian.enqueue("Gita - NIM 2021007")
    antrian.tampilkan_antrian()

    # Panggil semua sisa antrian
    print(">> Memproses semua sisa antrian:\n")
    while not antrian.is_empty():
        antrian.dequeue()

    antrian.tampilkan_antrian()
    antrian.dequeue()  # Coba dequeue saat kosong


if __name__ == "__main__":
    main()

